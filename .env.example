# DeepSeek V4.1 Flash preset; model, URL, and effort mirror AI-demo.
# Official API alias (checked 2026-10-29):
# https://api-docs.deepseek.com/quick_start/pricing/
export MODEL=deepseek-flash
export BASE_URL=https://api.deepseek.com
export REASONING_EFFORT=high

# Fill this only in your local, Git-ignored .env. Never commit a real key.
export API_KEY=

# AI-demo's default reserved output allowance, including reasoning tokens.
export MAX_OUTPUT_TOKENS=8192

# Live-acceptance time limits; these override the application's defaults.
export MODEL_TIMEOUT_SECONDS=120
export MAX_RUN_SECONDS=600

# Explicitly load .env with uv; no dotenv package is required.
# Check configuration locally without making a model request:
# uv run --locked --env-file .env python -m src.config
# Run the real model only after filling API_KEY:
# uv run --locked --env-file .env python -m src.main --mode live --input examples/normal.input.json
# Offline mode needs no credentials. Public model_settings omit keys and URLs.
