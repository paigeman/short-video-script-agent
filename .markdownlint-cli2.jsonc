{
  "globs": ["**/*.md"],
  "ignores": [
    ".agent-tmp/**",
    ".cache/**",
    ".idea/**",
    ".vscode/**",
    ".venv/**",
    "venv/**",
    "node_modules/**",
    "build/**",
    "dist/**",
    "htmlcov/**",
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD025": {
      "front_matter_title": "",
    },
    "MD024": {
      "siblings_only": true,
    },
    "MD046": {
      "style": "fenced",
    },
    "MD048": {
      "style": "backtick",
    },
    "MD049": {
      "style": "asterisk",
    },
    "MD050": {
      "style": "asterisk",
    },
  },
}
